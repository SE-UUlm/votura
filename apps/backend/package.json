    "@tsconfig/node22": "^22.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.16",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",

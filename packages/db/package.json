{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "postgres-up": "docker compose up -d",
    "postgres-down": "docker compose down",
    "gen-types": "kysely-codegen",
    "migrate": "tsx ./src/migrate.ts",
    "seed": "tsx ./src/runSeed.ts",
    "lint": "eslint",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/logger": "*",
    "dotenv": "^17.2.0",
    "kysely": "^0.28.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@testcontainers/postgresql": "^12.0.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/pg": "^8.15.4",
    "eslint": "^9.25.1",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.31.0"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./types": "./dist/types/db.d.ts",
    "./migrateToLatest": {
      "types": "./dist/migrateToLatest.d.ts",
      "default": "./dist/migrateToLatest.js"
    },
    "./genericContainer": {
      "types": "./dist/genericContainer.d.ts",
      "default": "./dist/genericContainer.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    }
  }
}
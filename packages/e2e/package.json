{
  "name": "@repo/e2e",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-types": "tsc --noEmit",
    "install-browsers": "npx playwright install --with-deps",
    "lint": "eslint",
    "test": "playwright test && nyc report --temp-dir ../../apps/frontend/.nyc_output --report-dir ../../apps/frontend/coverage --reporter=clover --reporter=text-summary"
  },
  "dependencies": {
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@playwright/test": "^1.53.2",
    "@repo/db": "*",
    "@repo/eslint-config": "*",
    "@repo/logger": "*",
    "@repo/typescript-config": "*",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^22.15.16",
    "@types/wait-on": "^5.3.4",
    "@votura/backend": "*",
    "@votura/frontend": "*",
    "eslint": "^9.25.1",
    "nyc": "^18.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.31.0",
    "wait-on": "^9.0.1"
  }
}

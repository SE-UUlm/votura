{
  "name": "votura",
  "version": "0.0.0",
  "description": "Votura is a web based open source voting system.",
  "keywords": [
    "voting"
  ],
  "homepage": "https://se-uulm.github.io/votura/",
  "bugs": {
    "url": "https://github.com/SE-UUlm/votura/issues"
  },
  "license": "MIT",
  "author": {
    "name": "University of Ulm",
    "url": "https://www.uni-ulm.de"
  },
  "contributors": [
    {
      "name": "Thorben Carl",
      "email": "thorben.carl@uni-ulm.decom",
      "url": "https://github.com/ThorbenCarl"
    },
    {
      "name": "Sören S. Hoffmann",
      "email": "soeren.hoffmann@uni-ulm.decom",
      "url": "https://github.com/shoffma"
    },
    {
      "name": "Johannes Kortmann",
      "email": "Johannes.kortmann@uni-ulm.decom",
      "url": "https://github.com/JKortmann"
    },
    {
      "name": "David Sievers",
      "email": "david.sievers@uni-ulm.decom",
      "url": "https://github.com/dsiev"
    },
    {
      "name": "Alexander Raschke",
      "email": "alexander.raschke@uni-ulm.de",
      "url": "https://github.com/araschke"
    }
  ],
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SE-UUlm/votura.git"
  },
  "scripts": {
    "format": "prettier --write . && turbo run format",
    "check-format": "prettier --check . && turbo run check-format",
    "check-spell": "cspell lint **",
    "check-types": "turbo run check-types",
    "build": "turbo run build",
    "test": "turbo run test",
    "start": "turbo run start",
    "ci": "turbo run check-format && turbo run check-types && turbo run build",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@eslint/compat": "^2.1.1",
    "cspell": "^10.3.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.10.7",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "js-yaml": "^4.3.2",
    "serialize-javascript": "^7.0.5",
    "faker": "^10.5.0"
  },
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "type": "module"
}
